"""Command line entry point for {{name}}."""

from tbx_shared.cli import ToolContext, define_tool, load_manifest

MANIFEST = load_manifest(__file__)


def run(ctx: ToolContext) -> None:
    """Do the work of {{name}}."""
    ctx.out.result(MANIFEST["name"])


if __name__ == "__main__":
    define_tool(MANIFEST, run)
