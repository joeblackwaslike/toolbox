{
  "name": "tbx-cli",
  "version": "{{VERSION}}",
  "description": "Launcher for the tbx CLI: downloads and runs the checksum-verified release binary.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblackwaslike/toolbox.git"
  },
  "bin": {
    "tbx": "bin/tbx.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tbxChecksums": {
    "tbx-darwin-arm64": "{{SHA_TBX_DARWIN_ARM64}}",
    "tbx-darwin-x64": "{{SHA_TBX_DARWIN_X64}}",
    "tbx-linux-arm64": "{{SHA_TBX_LINUX_ARM64}}",
    "tbx-linux-x64": "{{SHA_TBX_LINUX_X64}}"
  }
}
